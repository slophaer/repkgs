+/*
+ * The directory of the running executable, so helpers (bin/trust,
+ * libexec/p11-kit) are found next to it and not under a prefix that was
+ * compiled in. NULL when the system cannot tell.
+ */
+char *
+p11_path_self_dir (void)
+{
+#ifdef OS_UNIX
+	char buf[4096];
+	ssize_t len;
+
+	len = readlink ("/proc/self/exe", buf, sizeof (buf) - 1);
+	if (len <= 0)
+		return NULL;
+	buf[len] = '\0';
+	return p11_path_parent (buf);
+#else
+	return NULL;
+#endif
+}
+
 char *
 p11_path_parent (const char *path)
 {
