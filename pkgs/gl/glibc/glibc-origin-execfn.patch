glibc: expand $ORIGIN from AT_EXECFN without /proc

_dl_get_origin reads /proc/self/exe and, if that fails, LD_ORIGIN_PATH.
With no /proc, as in the init of an initrd, a binary with a $ORIGIN
RUNPATH cannot load its libraries.

Save AT_EXECFN in _dl_execfn and use its directory as the last resort.
It is the name given to execve, so make a relative one absolute with
getcwd, which needs no /proc. It is not canonical: a symbolic link keeps
the directory of the link. Ignore it for setuid programs, as the
environment is.

--- a/sysdeps/unix/sysv/linux/dl-origin.c
+++ b/sysdeps/unix/sysv/linux/dl-origin.c
@@ -23,6 +23,66 @@
 #include <sysdep.h>
 #include <fd_to_filename.h>
 
+#include <unistd.h>
+
+/* Directory part of the executable's name, AT_EXECFN, as an absolute path
+   in a malloc'd string without trailing slash.  AT_EXECFN is the name
+   given to execve and is not canonical: it may be relative, or name a
+   symbolic link.  Returns NULL if there is no usable name.  */
+static char *
+origin_from_execfn (void)
+{
+  const char *fn = GLRO(dl_execfn);
+  if (fn == NULL || fn[0] == '\0')
+    return NULL;
+
+  /* ld.so has no strrchr: find the last slash by hand.  */
+  size_t dirlen = 0;
+  for (size_t i = 0; fn[i] != '\0'; ++i)
+    if (fn[i] == '/')
+      dirlen = i;
+  char cwd[PATH_MAX];
+  size_t cwdlen = 0;
+  if (fn[0] != '/')
+    {
+      /* Relative to the working directory, which getcwd gives without
+	 /proc.  */
+      long int r = INTERNAL_SYSCALL_CALL (getcwd, cwd, sizeof (cwd));
+      if (r <= 1 || cwd[0] != '/')
+	return NULL;
+      cwdlen = r - 1;
+      while (cwdlen > 1 && cwd[cwdlen - 1] == '/')
+	--cwdlen;
+    }
+
+  /* Absolute: the name up to the last slash, "/" if that is the root.
+     Relative: the working directory, then "/" and the name's directory.  */
+  size_t len = fn[0] == '/' ? (dirlen == 0 ? 1 : dirlen)
+			    : cwdlen + (dirlen == 0 ? 0 : 1 + dirlen);
+  char *result = malloc (len + 1);
+  if (result == NULL)
+    return NULL;
+  char *cp = result;
+  if (fn[0] == '/')
+    {
+      if (dirlen == 0)
+	*cp++ = '/';
+      else
+	cp = __mempcpy (cp, fn, dirlen);
+    }
+  else
+    {
+      cp = __mempcpy (cp, cwd, cwdlen);
+      if (dirlen != 0)
+	{
+	  *cp++ = '/';
+	  cp = __mempcpy (cp, fn, dirlen);
+	}
+    }
+  *cp = '\0';
+  return result;
+}
+
 /* On Linux >= 2.1 systems which have the dcache implementation we can get
    the path of the application from the /proc/self/exe symlink.  Try this
    first and fall back on the generic method if necessary.  */
@@ -55,7 +115,15 @@
       result = (char *) -1;
       /* We use the environment variable LD_ORIGIN_PATH.  If it is set make
 	 a copy and strip out trailing slashes.  */
-      if (GLRO(dl_origin_path) != NULL)
+      if (GLRO(dl_origin_path) == NULL && !__libc_enable_secure)
+	{
+	  /* /proc is not mounted, e.g. in an initrd: use the name the
+	     kernel passed in AT_EXECFN.  */
+	  char *execfn = origin_from_execfn ();
+	  if (execfn != NULL)
+	    result = execfn;
+	}
+      else if (GLRO(dl_origin_path) != NULL)
 	{
 	  size_t len = strlen (GLRO(dl_origin_path));
 	  result = (char *) malloc (len + 1);
--- a/sysdeps/generic/ldsodefs.h
+++ b/sysdeps/generic/ldsodefs.h
@@ -589,6 +589,9 @@
   /* Location of the binary.  */
   EXTERN const char *_dl_origin_path;
 
+  /* AT_EXECFN, the name the kernel was asked to execute.  */
+  EXTERN const char *_dl_execfn;
+
   /* Size of the static TLS block.  */
   EXTERN size_t _dl_tls_static_size;
 
--- a/elf/dl-support.c
+++ b/elf/dl-support.c
@@ -72,6 +72,7 @@
 
 /* Path where the binary is found.  */
 const char *_dl_origin_path;
+const char *_dl_execfn;
 
 /* Nonzero if runtime lookup should not update the .got/.plt.  */
 int _dl_bind_not;
--- a/sysdeps/unix/sysv/linux/dl-parse_auxv.h
+++ b/sysdeps/unix/sysv/linux/dl-parse_auxv.h
@@ -47,6 +47,7 @@
   GLRO(dl_pagesize) = auxv_values[AT_PAGESZ];
   __libc_enable_secure = auxv_values[AT_SECURE];
   GLRO(dl_platform) = (void *) auxv_values[AT_PLATFORM];
+  GLRO(dl_execfn) = (const char *) auxv_values[AT_EXECFN];
   GLRO(dl_hwcap) = auxv_values[AT_HWCAP];
   GLRO(dl_hwcap2) = auxv_values[AT_HWCAP2];
   GLRO(dl_hwcap3) = auxv_values[AT_HWCAP3];
