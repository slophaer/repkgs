glibc: expand $ORIGIN from AT_EXECFN without /proc, resolving symlinks

_dl_get_origin reads /proc/self/exe and, if that fails, LD_ORIGIN_PATH.
With no /proc, as in the init of an initrd, a binary with a $ORIGIN
RUNPATH cannot load its libraries.

Save AT_EXECFN in _dl_execfn and use its directory as the last resort.
It is the name given to execve, so make a relative one absolute with
getcwd, which needs no /proc. Resolve symlinks in each path component
using readlink(2), so a symlink like /init -> ../nix/store/.../bin/x
gives the target's directory, not "/". Ignore it for setuid programs,
as the environment is.

--- a/sysdeps/unix/sysv/linux/dl-origin.c
+++ b/sysdeps/unix/sysv/linux/dl-origin.c
@@ -23,6 +23,158 @@
 #include <sysdep.h>
 #include <fd_to_filename.h>
 
+#include <unistd.h>
+
+/* Resolve symlinks in a path without /proc, by walking each component and
+   calling readlink(2). This is a minimal realpath for early boot (initrd
+   PID 1, no /proc). Assumes the path is absolute. Does not handle . or ..
+   (exec'd paths don't have them). Returns a malloc'd resolved path, or
+   NULL on failure.  */
+static char *
+resolve_symlinks (const char *path)
+{
+  char resolved[PATH_MAX];
+  char link[PATH_MAX];
+  size_t rlen = 0;
+  const char *p = path;
+  int loop_count = 0;
+  const int max_loops = 40;  /* Symlink recursion limit */
+
+  if (path == NULL || path[0] != '/')
+    return NULL;
+
+  resolved[rlen++] = '/';
+  resolved[rlen] = '\0';
+
+  while (*p && loop_count < max_loops)
+    {
+      /* Skip leading slashes.  */
+      while (*p == '/')
+	p++;
+      if (*p == '\0')
+	break;
+
+      /* Find end of this component.  */
+      const char *end = p;
+      while (*end && *end != '/')
+	end++;
+      size_t complen = end - p;
+      if (complen == 0)
+	continue;
+
+      /* Build path to check: resolved + / + component.  */
+      if (rlen + 1 + complen >= PATH_MAX)
+	return NULL;
+      if (rlen > 1)
+	resolved[rlen++] = '/';
+      __mempcpy (resolved + rlen, p, complen);
+      rlen += complen;
+      resolved[rlen] = '\0';
+
+      /* Try to read as symlink.  */
+      ssize_t llen = INTERNAL_SYSCALL_CALL (readlink, resolved, link, PATH_MAX - 1);
+      if (llen > 0 && llen < PATH_MAX)
+	{
+	  /* It's a symlink.  */
+	  link[llen] = '\0';
+	  loop_count++;
+
+	  if (link[0] == '/')
+	    {
+	      /* Absolute symlink: restart from the link target.  */
+	      rlen = llen;
+	      __mempcpy (resolved, link, llen + 1);
+	    }
+	  else
+	    {
+	      /* Relative symlink: replace the last component with the link.
+		 Back up to remove the component we just added.  */
+	      while (rlen > 1 && resolved[rlen - 1] != '/')
+		rlen--;
+	      if (rlen > 1)
+		rlen--;  /* Remove the slash too if not root.  */
+	      /* Append the link.  */
+	      if (rlen + 1 + llen >= PATH_MAX)
+		return NULL;
+	      if (rlen > 0 && resolved[rlen - 1] != '/')
+		resolved[rlen++] = '/';
+	      __mempcpy (resolved + rlen, link, llen);
+	      rlen += llen;
+	      resolved[rlen] = '\0';
+	    }
+	}
+      /* else: not a symlink, keep the component.  */
+
+      p = end;
+    }
+
+  if (loop_count >= max_loops)
+    return NULL;  /* Too many symlinks.  */
+
+  char *result = malloc (rlen + 1);
+  if (result != NULL)
+    __mempcpy (result, resolved, rlen + 1);
+  return result;
+}
+
+/* Directory part of the executable's name, AT_EXECFN, as an absolute path
+   in a malloc'd string without trailing slash.  AT_EXECFN is the name
+   given to execve, so make a relative one absolute with getcwd and resolve
+   symlinks. Returns NULL if there is no usable name.  */
+static char *
+origin_from_execfn (void)
+{
+  const char *fn = GLRO(dl_execfn);
+  if (fn == NULL || fn[0] == '\0')
+    return NULL;
+
+  /* Make the path absolute if needed.  */
+  char abspath[PATH_MAX];
+  if (fn[0] != '/')
+    {
+      /* Relative to the working directory, which getcwd gives without /proc.  */
+      long int r = INTERNAL_SYSCALL_CALL (getcwd, abspath, sizeof (abspath));
+      if (r <= 1 || abspath[0] != '/')
+	return NULL;
+      size_t cwdlen = r - 1;
+      while (cwdlen > 1 && abspath[cwdlen - 1] == '/')
+	--cwdlen;
+      size_t fnlen = 0;
+      while (fn[fnlen] != '\0')
+	fnlen++;
+      if (cwdlen + 1 + fnlen >= PATH_MAX)
+	return NULL;
+      abspath[cwdlen] = '/';
+      __mempcpy (abspath + cwdlen + 1, fn, fnlen + 1);
+      fn = abspath;
+    }
+
+  /* Resolve symlinks to get the real path.  */
+  char *resolved = resolve_symlinks (fn);
+  if (resolved == NULL)
+    return NULL;
+
+  /* Find the directory part (everything up to the last slash).  */
+  size_t len = 0;
+  size_t last_slash = 0;
+  while (resolved[len] != '\0')
+    {
+      if (resolved[len] == '/')
+	last_slash = len;
+      len++;
+    }
+
+  /* Return the directory, or "/" if no slash found.  */
+  if (last_slash == 0)
+    {
+      resolved[1] = '\0';
+      return resolved;
+    }
+
+  resolved[last_slash] = '\0';
+  return resolved;
+}
+
 /* On Linux >= 2.1 systems which have the dcache implementation we can get
    the path of the application from the /proc/self/exe symlink.  Try this
    first and fall back on the generic method if necessary.  */
@@ -55,7 +207,15 @@ _dl_get_origin (void)
       result = (char *) -1;
       /* We use the environment variable LD_ORIGIN_PATH.  If it is set make
 	 a copy and strip out trailing slashes.  */
-      if (GLRO(dl_origin_path) != NULL)
+      if (GLRO(dl_origin_path) == NULL && !__libc_enable_secure)
+	{
+	  /* /proc is not mounted, e.g. in an initrd: use the name the
+	     kernel passed in AT_EXECFN, resolving symlinks.  */
+	  char *execfn = origin_from_execfn ();
+	  if (execfn != NULL)
+	    result = execfn;
+	}
+      else if (GLRO(dl_origin_path) != NULL)
 	{
 	  size_t len = strlen (GLRO(dl_origin_path));
 	  result = (char *) malloc (len + 1);
--- a/sysdeps/generic/ldsodefs.h
+++ b/sysdeps/generic/ldsodefs.h
@@ -595,6 +595,9 @@ struct rtld_global_ro
   EXTERN const char *_dl_rtld_dir;
   EXTERN size_t _dl_rtld_dirlen;
 
+  /* AT_EXECFN, the name the kernel was asked to execute.  */
+  EXTERN const char *_dl_execfn;
+
   /* Size of the static TLS block.  */
   EXTERN size_t _dl_tls_static_size;
 
--- a/elf/dl-support.c
+++ b/elf/dl-support.c
@@ -72,6 +72,7 @@ int _dl_debug_fd = STDERR_FILENO;
 
 /* Path where the binary is found.  */
 const char *_dl_origin_path;
+const char *_dl_execfn;
 
 /* Nonzero if runtime lookup should not update the .got/.plt.  */
 int _dl_bind_not;
--- a/sysdeps/unix/sysv/linux/dl-parse_auxv.h
+++ b/sysdeps/unix/sysv/linux/dl-parse_auxv.h
@@ -47,6 +47,7 @@ void _dl_parse_auxv (ElfW(auxv_t) *av, d
   GLRO(dl_pagesize) = auxv_values[AT_PAGESZ];
   __libc_enable_secure = auxv_values[AT_SECURE];
   GLRO(dl_platform) = (void *) auxv_values[AT_PLATFORM];
+  GLRO(dl_execfn) = (const char *) auxv_values[AT_EXECFN];
   GLRO(dl_hwcap) = auxv_values[AT_HWCAP];
   GLRO(dl_hwcap2) = auxv_values[AT_HWCAP2];
   GLRO(dl_hwcap3) = auxv_values[AT_HWCAP3];
